# Copy to .env and fill in. Never commit the result.
#
#   cp .env.example .env
#
# `.env` is git-ignored via `.env` and `.env.*` (no trailing slash). If you edit
# .gitignore, do not reintroduce the slash - see SECURITY.md.

# --- core --------------------------------------------------------------------
GN_ENV=development
GN_PORT=8000

# --- enrich service ----------------------------------------------------------
GN_ENRICH_PORT=8010
GN_ENRICH_TIMEOUT_SECONDS=8

# --- auth --------------------------------------------------------------------
# Required in production - the gateway refuses to boot without it. Auto-generated
# per process in development, which invalidates tokens on restart by design.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
GN_JWT_SECRET=
GN_JWT_EXPIRE_MINUTES=1440

# --- infrastructure ----------------------------------------------------------
GN_KAFKA_BOOTSTRAP=kafka:9092
GN_OPENSEARCH_URL=http://opensearch:9200

# --- reputation providers ----------------------------------------------------
# Empty is fine: `enrich` skips a provider with no key rather than failing. A
# skipped provider is excluded from the verdict, never scored as clean.
GN_IPINFO_TOKEN=
GN_ABUSEIPDB_KEY=
GN_IPQS_KEY=
GN_IPGEO_API_KEY=
GN_HTTPBL_KEY=

# --- container scanning ------------------------------------------------------
GN_SNYK_TOKEN=
