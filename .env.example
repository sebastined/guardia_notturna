# Copy to .env and fill in. Never commit the result.

GN_ENV=development
GN_PORT=8000

# Required in production; auto-generated per-process in development.
GN_JWT_SECRET=
GN_JWT_EXPIRE_MINUTES=1440

GN_KAFKA_BOOTSTRAP=kafka:9092
GN_OPENSEARCH_URL=http://opensearch:9200

# --- reputation providers (enrich service) -----------------------------------
GN_IPINFO_TOKEN=
GN_ABUSEIPDB_KEY=
GN_IPQS_KEY=
GN_IPGEO_API_KEY=

# --- container scanning ------------------------------------------------------
GN_SNYK_TOKEN=
